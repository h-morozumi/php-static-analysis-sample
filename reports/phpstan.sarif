{
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "version": "2.1.0",
    "runs": [
        {
            "tool": {
                "driver": {
                    "name": "PHPStan",
                    "fullName": "PHP Static Analysis Tool",
                    "informationUri": "https://phpstan.org",
                    "version": "1.12.32",
                    "semanticVersion": "1.12.32",
                    "rules": [
                        {
                            "id": "missingType.property",
                            "shortDescription": {
                                "text": "Property App\\DatabaseVulnerability::$pdo has no type specified."
                            }
                        },
                        {
                            "id": "missingType.parameter",
                            "shortDescription": {
                                "text": "Method App\\XssVulnerability::createLink() has parameter $url with no type specified."
                            }
                        },
                        {
                            "id": "missingType.return",
                            "shortDescription": {
                                "text": "Method App\\XssVulnerability::createLink() has no return type specified."
                            }
                        },
                        {
                            "id": "deadCode.unreachable",
                            "shortDescription": {
                                "text": "Unreachable statement - code above always terminates."
                            }
                        },
                        {
                            "id": "method.unused",
                            "shortDescription": {
                                "text": "Method App\\DeadCodeVulnerability::unusedMethod() is unused."
                            }
                        },
                        {
                            "id": "greater.alwaysTrue",
                            "shortDescription": {
                                "text": "Comparison operation \">\" between 10 and 5 is always true."
                            }
                        },
                        {
                            "id": "else.unreachable",
                            "shortDescription": {
                                "text": "Else branch is unreachable because previous condition is always true."
                            }
                        },
                        {
                            "id": "argument.type",
                            "shortDescription": {
                                "text": "Parameter #1 $string of function strlen expects string, string|null given."
                            }
                        },
                        {
                            "id": "variable.undefined",
                            "shortDescription": {
                                "text": "Undefined variable: $result"
                            }
                        }
                    ]
                }
            },
            "originalUriBaseIds": {
                "WORKINGDIR": {
                    "uri": "file:///workspaces/php-static-analysis-sample/"
                }
            },
