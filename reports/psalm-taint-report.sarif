tartColumn":21,"endColumn":26}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":78,"endLine":78,"startColumn":9,"endColumn":18}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":79,"endLine":79,"startColumn":25,"endColumn":34}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":15,"endLine":15,"startColumn":30,"endColumn":39}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":15,"endLine":15,"startColumn":30,"endColumn":39}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":19,"endLine":19,"startColumn":34,"endColumn":43}}}}]}]}]},{"ruleId":"255","message":{"text":"Detected tainted file handling"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":29,"endLine":29,"startColumn":27,"endColumn":32}}}],"codeFlows":[{"message":{"text":"Tracing the path from user input to insecure usage"},"threadFlows":[{"locations":[{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":82,"endLine":82,"startColumn":17,"endColumn":23}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":82,"endLine":82,"startColumn":9,"endColumn":14}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":84,"endLine":84,"startColumn":25,"endColumn":30}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":26,"endLine":26,"startColumn":30,"endColumn":35}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":26,"endLine":26,"startColumn":30,"endColumn":35}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/FileVulnerability.php"},"region":{"startLine":29,"endLine":29,"startColumn":27,"endColumn":32}}}}]}]}]},{"ruleId":"252","message":{"text":"Detected tainted code passed to eval or similar"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":38,"endLine":38,"startColumn":14,"endColumn":19}}}],"codeFlows":[{"message":{"text":"Tracing the path from user input to insecure usage"},"threadFlows":[{"locations":[{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":65,"endLine":65,"startColumn":17,"endColumn":23}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":65,"endLine":65,"startColumn":9,"endColumn":14}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":66,"endLine":66,"startColumn":32,"endColumn":37}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":35,"endLine":35,"startColumn":33,"endColumn":38}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":35,"endLine":35,"startColumn":33,"endColumn":38}}}}]}]}]},{"ruleId":"246","message":{"text":"Detected tainted shell code"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":48,"endLine":48,"startColumn":30,"endColumn":50}}}],"codeFlows":[{"message":{"text":"Tracing the path from user input to insecure usage"},"threadFlows":[{"locations":[{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":61,"endLine":61,"startColumn":17,"endColumn":22}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":61,"endLine":61,"startColumn":9,"endColumn":14}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":62,"endLine":62,"startColumn":29,"endColumn":34}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":45,"endLine":45,"startColumn":30,"endColumn":35}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":45,"endLine":45,"startColumn":30,"endColumn":35}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":48,"endLine":48,"startColumn":30,"endColumn":50}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":48,"endLine":48,"startColumn":30,"endColumn":50}}}}]}]}]},{"ruleId":"250","message":{"text":"Detected tainted code passed to unserialize or similar"},"level":"error","locations":[{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":59,"endLine":59,"startColumn":28,"endColumn":43}}}],"codeFlows":[{"message":{"text":"Tracing the path from user input to insecure usage"},"threadFlows":[{"locations":[{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":96,"endLine":96,"startColumn":17,"endColumn":25}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":96,"endLine":96,"startColumn":9,"endColumn":14}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/EntryPoint.php"},"region":{"startLine":97,"endLine":97,"startColumn":29,"endColumn":34}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine":56,"endLine":56,"startColumn":30,"endColumn":45}}}},{"location":{"physicalLocation":{"artifactLocation":{"uri":"src\/SecurityVulnerability.php"},"region":{"startLine"